@model IReadOnlyList<DealerDatabase.Data.Entities.Dealer>
@{
    ViewData["Title"] = "Dealers";
}

<h1 class="h3 mb-3">Dealers</h1>
<p class="text-muted">@Model.Count consolidated dealerships</p>

@if (Model.Count == 0)
{
    <p class="text-muted">No dealers found. Run the import console application to populate the database.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Company no.</th>
                    <th>VAT</th>
                    <th>FCA FRN</th>
                    <th>Postcode</th>
                    <th>Sources</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var dealer in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@dealer.Id">@dealer.Name</a>
                        @if (!string.IsNullOrWhiteSpace(dealer.LegalName) && dealer.LegalName != dealer.Name)
                        {
                            <div class="small text-muted">@dealer.LegalName</div>
                        }
                    </td>
                    <td>@dealer.CompanyNumber</td>
                    <td>
                        @dealer.VatNumber
                        @if (!string.IsNullOrWhiteSpace(dealer.VatValidationStatus))
                        {
                            <span class="badge bg-secondary">@dealer.VatValidationStatus</span>
                        }
                    </td>
                    <td>
                        @dealer.FcaFrn
                        @if (!string.IsNullOrWhiteSpace(dealer.FcaStatus))
                        {
                            <div class="small text-muted">@dealer.FcaStatus</div>
                        }
                    </td>
                    <td>@(dealer.Postcode ?? dealer.RegisteredPostcode)</td>
                    <td class="small">@dealer.Sources</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
